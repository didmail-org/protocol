{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://didmail.io/protocol/dmp/1/schema.json",
  "title": "DIDMail Protocol 1 working draft",
  "$defs": {
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "verificationMethod": {
          "type": "string"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "algorithm",
        "verificationMethod",
        "publicKey",
        "signature"
      ]
    },
    "KeyRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "ownerId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cryptoSuite": {
          "const": "HPKE-X25519-HKDF-SHA256-AES256GCM"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "protocolVersion",
        "ownerId",
        "keyId",
        "cryptoSuite",
        "publicKey",
        "createdAt",
        "expiresAt",
        "proof"
      ]
    },
    "KeyRevocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "ownerId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "enum": [
            "rotated",
            "compromised",
            "retired"
          ]
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "protocolVersion",
        "ownerId",
        "keyId",
        "revokedAt",
        "reason",
        "proof"
      ]
    },
    "Blob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunkCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65
        },
        "ciphertextSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunkSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 65
        }
      },
      "required": [
        "blobId",
        "sizeBytes",
        "chunkCount",
        "ciphertextSha256",
        "chunkSha256"
      ]
    },
    "KeyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "keyRecord": {
          "$ref": "#/$defs/KeyRecord"
        },
        "encapsulatedKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "ownerId",
        "keyId",
        "keyRecord",
        "encapsulatedKey",
        "ciphertext"
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "senderId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "recipientId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "serviceId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cryptoSuite": {
          "const": "HPKE-X25519-HKDF-SHA256-AES256GCM"
        },
        "keyEnvelopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyEnvelope"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "documentBlobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "blobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blob"
          },
          "minItems": 1,
          "maxItems": 21
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        },
        "automaticDelivery": {
          "const": true
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "senderId",
        "recipientId",
        "serviceId",
        "createdAt",
        "planId",
        "cryptoSuite",
        "keyEnvelopes",
        "documentBlobId",
        "blobs",
        "proof"
      ]
    },
    "Retention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "finite"
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3153600000
            }
          },
          "required": [
            "mode",
            "durationSeconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "indefinite"
            }
          },
          "required": [
            "mode"
          ]
        }
      ]
    },
    "Settlement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "arcblock-transfer-v3-mail-nft/1",
            "none"
          ]
        },
        "chainId": {
          "type": "string"
        },
        "chainEndpoint": {
          "type": "string",
          "format": "uri"
        },
        "paymentAssetId": {
          "type": "string"
        },
        "paymentAssetDecimals": {
          "const": 18
        },
        "envelopeFactoryId": {
          "type": "string"
        },
        "messageFactoryId": {
          "type": "string"
        },
        "payerId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "servicePayeeAddress": {
          "type": "string"
        },
        "developerPayeeAddress": {
          "type": "string"
        },
        "indexLocatorField": {
          "const": "subject"
        },
        "confirmationPolicy": {
          "enum": [
            "arcblock-committed",
            "arcblock-dolt-ledger/1"
          ]
        }
      },
      "required": [
        "profile",
        "chainId",
        "chainEndpoint",
        "paymentAssetId",
        "paymentAssetDecimals",
        "envelopeFactoryId",
        "messageFactoryId",
        "payerId",
        "servicePayeeAddress",
        "developerPayeeAddress",
        "indexLocatorField",
        "confirmationPolicy"
      ]
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quoteId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "quoteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serviceId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "planId": {
          "type": "string"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "paymentAsset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chainId": {
              "type": "string"
            },
            "assetId": {
              "type": "string"
            },
            "decimals": {
              "const": 18
            },
            "symbol": {
              "type": "string"
            }
          },
          "required": [
            "chainId",
            "assetId",
            "decimals",
            "symbol"
          ]
        },
        "envelopeAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "storageAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "totalAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "indexAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "developerAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "serviceAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "settlement": {
          "$ref": "#/$defs/Settlement"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        },
        "funding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "node-sponsored"
            },
            "sponsorId": {
              "type": "string",
              "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,77}$"
            }
          },
          "required": [
            "mode",
            "sponsorId",
            "amount"
          ]
        },
        "delivery": {
          "const": "server"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "memberBindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "senderRevision": {
              "type": "integer",
              "minimum": 1
            },
            "recipientRevision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "senderRevision",
            "recipientRevision"
          ]
        }
      },
      "required": [
        "quoteId",
        "quoteVersion",
        "messageId",
        "manifestSha256",
        "serviceId",
        "planId",
        "issuedAt",
        "expiresAt",
        "paymentAsset",
        "envelopeAmount",
        "storageAmount",
        "totalAmount",
        "indexAmount",
        "developerAmount",
        "serviceAmount",
        "retention",
        "settlement",
        "proof"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "delivery",
              "policyRevision",
              "memberBindings"
            ],
            "properties": {
              "funding": false,
              "settlement": {
                "properties": {
                  "profile": {
                    "const": "none"
                  }
                }
              },
              "totalAmount": {
                "const": "0"
              },
              "envelopeAmount": {
                "const": "0"
              },
              "storageAmount": {
                "const": "0"
              },
              "indexAmount": {
                "const": "0"
              },
              "developerAmount": {
                "const": "0"
              },
              "serviceAmount": {
                "const": "0"
              },
              "retention": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "const": "finite"
                  },
                  "durationSeconds": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "mode",
                  "durationSeconds"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "policyRevision": false,
              "memberBindings": false,
              "settlement": {
                "properties": {
                  "profile": {
                    "const": "arcblock-transfer-v3-mail-nft/1"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "messageId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quoteId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "senderId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "recipientId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "serviceId": {
          "type": "string",
          "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time"
        },
        "retentionExpiresAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "payment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chainId": {
                  "type": "string"
                },
                "transactionId": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{64}$"
                },
                "blockHeight": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "confirmedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "confirmationPolicy": {
                  "const": "arcblock-committed"
                }
              },
              "required": [
                "chainId",
                "transactionId",
                "blockHeight",
                "confirmedAt"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chainId": {
                  "type": "string"
                },
                "transactionId": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{64}$"
                },
                "confirmedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "confirmationPolicy": {
                  "const": "arcblock-dolt-ledger/1"
                },
                "ledgerBackend": {
                  "const": "@ocap/statedb-dolt v1.20.2"
                }
              },
              "required": [
                "chainId",
                "transactionId",
                "confirmedAt",
                "confirmationPolicy",
                "ledgerBackend"
              ]
            }
          ]
        },
        "index": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chainId": {
                  "type": "string"
                },
                "transactionId": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{64}$"
                },
                "blockHeight": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "confirmedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "assetId": {
                  "type": "string"
                },
                "confirmationPolicy": {
                  "const": "arcblock-committed"
                }
              },
              "required": [
                "chainId",
                "transactionId",
                "blockHeight",
                "confirmedAt",
                "assetId"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chainId": {
                  "type": "string"
                },
                "transactionId": {
                  "type": "string",
                  "pattern": "^[0-9A-F]{64}$"
                },
                "confirmedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "assetId": {
                  "type": "string"
                },
                "confirmationPolicy": {
                  "const": "arcblock-dolt-ledger/1"
                },
                "ledgerBackend": {
                  "const": "@ocap/statedb-dolt v1.20.2"
                }
              },
              "required": [
                "chainId",
                "transactionId",
                "confirmedAt",
                "assetId",
                "confirmationPolicy",
                "ledgerBackend"
              ]
            }
          ]
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        },
        "delivery": {
          "const": "server"
        },
        "termsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "funding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "node-sponsored"
            },
            "sponsorId": {
              "type": "string",
              "pattern": "^did:abt:z[1-9A-HJ-NP-Za-km-z]{20,64}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,77}$"
            }
          },
          "required": [
            "mode",
            "sponsorId",
            "amount"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "messageId",
        "manifestSha256",
        "quoteId",
        "senderId",
        "recipientId",
        "serviceId",
        "acceptedAt",
        "deliveredAt",
        "retentionExpiresAt",
        "proof"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "payment": {
                  "required": [
                    "blockHeight"
                  ]
                },
                "index": {
                  "required": [
                    "blockHeight"
                  ]
                }
              }
            },
            {
              "properties": {
                "payment": {
                  "required": [
                    "ledgerBackend"
                  ]
                },
                "index": {
                  "required": [
                    "ledgerBackend"
                  ]
                }
              }
            }
          ]
        }
      ],
      "oneOf": [
        {
          "required": [
            "delivery",
            "termsSha256"
          ],
          "properties": {
            "index": false,
            "payment": false,
            "funding": false,
            "retentionExpiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "required": [
            "index",
            "payment"
          ],
          "properties": {
            "delivery": false,
            "termsSha256": false,
            "funding": false
          }
        },
        {
          "required": [
            "index",
            "funding"
          ],
          "properties": {
            "delivery": false,
            "termsSha256": false,
            "payment": false
          }
        }
      ]
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "detail": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recoveryAction": {
          "type": "string"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "requestId",
        "recoveryAction"
      ]
    },
    "EmailDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentType": {
          "const": "email"
        },
        "subject": {
          "type": "string",
          "maxLength": 1024
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mediaType": {
              "enum": [
                "text/plain",
                "text/html"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "mediaType",
            "text"
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blobId": {
                "type": "string",
