    "/v1/messages/{messageId}/submit": {
      "post": {
        "operationId": "submitDelivery",
        "summary": "submitDelivery",
        "parameters": [
          {
            "in": "path",
            "name": "messageId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource or status returned"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Signature missing/invalid"
          },
          "409": {
            "description": "Replay, immutable conflict or state conflict"
          },
          "503": {
            "description": "Dependency unavailable"
          },
          "202": {
            "description": "Durable delivery accepted; poll Location with a fresh signed GET",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Delivery status URL"
              }
            }
          }
        },
        "security": [
          {
            "DmpIdentity": [],
            "DmpSignatureInput": [],
            "DmpSignature": [],
            "ContentDigest": [],
            "DmpIdentityKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quoteId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "signedTransaction": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$"
                      }
                    },
                    "required": [
                      "quoteId",
                      "signedTransaction"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quoteId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "delivery": {
                        "const": "server"
                      }
                    },
                    "required": [
                      "quoteId",
                      "delivery"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quoteId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "fundingMode": {
                        "const": "node-sponsored"
                      }
                    },
                    "required": [
                      "quoteId",
                      "fundingMode"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
