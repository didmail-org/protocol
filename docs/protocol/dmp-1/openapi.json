  "components": {
    "securitySchemes": {
      "DmpIdentity": {
        "type": "apiKey",
        "in": "header",
        "name": "DMP-Identity",
        "description": "Part of the mandatory combined DMP RFC9421 signature profile; not independently sufficient."
      },
      "DmpIdentityKey": {
        "type": "apiKey",
        "in": "header",
        "name": "DMP-Identity-Key",
        "description": "Part of the mandatory combined DMP RFC9421 signature profile; not independently sufficient."
      },
      "DmpSignatureInput": {
        "type": "apiKey",
        "in": "header",
        "name": "Signature-Input",
        "description": "Part of the mandatory combined DMP RFC9421 signature profile; not independently sufficient."
      },
      "DmpSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Signature",
        "description": "Part of the mandatory combined DMP RFC9421 signature profile; not independently sufficient."
      },
      "ContentDigest": {
        "type": "apiKey",
        "in": "header",
        "name": "Content-Digest",
        "description": "Part of the mandatory combined DMP RFC9421 signature profile; not independently sufficient."
      }
    }
