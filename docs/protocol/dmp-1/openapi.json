    "/v1/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "List external messages, or internal messages using delivery=server and a monotonic delivery sequence cursor",
        "parameters": [
          {
            "in": "query",
            "name": "mailbox",
            "required": true,
            "schema": {
              "enum": [
                "inbox",
                "outbox"
              ]
            }
          },
          {
            "in": "query",
            "name": "delivery",
            "schema": {
              "enum": [
                "server"
              ]
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor; internal lists use delivery sequence rather than UUID"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource or status returned"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Signature missing/invalid"
          },
          "409": {
